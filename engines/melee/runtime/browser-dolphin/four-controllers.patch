+// Diagnostic boundary invokes the same controller conversion the emulator polls.
+EMSCRIPTEN_KEEPALIVE int OpenSmashReadController(int port, int field)
+{
+  GCPadStatus status{};
+  if (!DolphinWeb_GetPadStatus(port, &status)) return -1;
+  switch (field) {
+    case 0: return status.isConnected; case 1: return status.button;
+    case 2: return status.stickX; case 3: return status.stickY;
+    case 4: return status.substickX; case 5: return status.substickY;
+    case 6: return status.triggerLeft; case 7: return status.triggerRight;
+    default: return -1;
+  }
