+EMSCRIPTEN_KEEPALIVE int OpenSmashControllerPorts() { return 4; }
+
+// Full snapshots from one owning worker, read atomically by Dolphin's CPU thread.
+EMSCRIPTEN_KEEPALIVE int SetControllerState(int port, int connected, std::uint32_t mask,
+    int x, int y, int cx, int cy, int left, int right, int a, int b, std::uint32_t generation)
+{
+  if (port < 0 || port >= 4 || (connected != 0 && connected != 1)) return 0;
+  InputStateSnapshot next;
+  if (connected) {
+    next.mask = mask & 0xfffffu;
+    next.generation = generation;
+    next.stick_x = ClampPadByte(x); next.stick_y = ClampPadByte(y);
+    next.c_stick_x = ClampPadByte(cx); next.c_stick_y = ClampPadByte(cy);
+    next.trigger_left = ClampPadByte(left); next.trigger_right = ClampPadByte(right);
+    next.analog_a = ClampPadByte(a); next.analog_b = ClampPadByte(b);
+  }
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  s_controller_states[port] = next;
+  s_controller_connected[port] = connected != 0;
+  return 1;
+}
